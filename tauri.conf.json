{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taurcord",
  "version": "0.2.2",
  "identifier": "com.iamchumby.taurcord",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "iAmChumby",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/vencord/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
